  <!-- ===================== 吸盘部分（核心修复：link_base+cup_link中心对称+位置100%正确） ===================== -->
  <link name="link_base">
    <inertial>
      <origin xyz="-5.76207681182315E-16 6.66133814775094E-16 -0.0250000000000002" rpy="0 0 0" />
      <mass value="0.098174770424681" />
      <inertia ixx="3.5792885050665E-05" ixy="-1.51709481005838E-36" ixz="4.60603334714609E-22"
               iyy="3.5792885050665E-05" iyz="-6.06271088687215E-21" izz="3.06796157577128E-05" />
    </inertial>
    <visual>
      <!-- 核心修复1：link_base中心对称修复，和cup_link完全一致的改法 -->
      <origin xyz="0 0 0" rpy="3.1416 0 3.1416" />
      <geometry>
        <mesh filename="package://robot_ec66/meshes/link_base.stl" />
      </geometry>
      <material name="link_base_mat">
        <color rgba="1 1 1 1" /> 
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="3.1416 0 3.1416" />
      <geometry>
        <mesh filename="package://robot_ec66/meshes/link_base.stl" />
      </geometry>
    </collision>
  </link>

  <!-- 完全用你SW导出的原始j7关节，不做任何修改 -->
  <joint name="j7" type="fixed">
    <origin xyz="0 0.089 0" rpy="1.5708 0 0" />
    <parent link="wrist_3_link" />
    <child link="link_base" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="cup_link">
    <inertial>
      <origin xyz="3.57421983766674E-05 0.000439440635704447 0.0170415851932638" rpy="0 0 0" />
      <mass value="0.153205468110546" />
      <inertia ixx="0.00012615591813755" ixy="2.34978035393046E-09" ixz="-1.18902892816163E-07"
               iyy="0.000125744916073752" iyz="-2.61800372514106E-06" izz="0.000175916091366397" />
    </inertial>
    <visual>
      <!-- 核心修复2：cup_link恢复正确中心对称+位置，完美贴合link_base -->
      <origin xyz="0 0 0" rpy="3.1416 0 3.1416" />
      <geometry>
        <mesh filename="package://robot_ec66/meshes/cup_link.stl" />
      </geometry>
      <material name="cup_link_mat">
        <color rgba="0 1 0 1" /> <!-- 绿色，区分link_base -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="3.1416 0 3.1416" />
      <geometry>
        <mesh filename="package://robot_ec66/meshes/cup_link.stl" />
      </geometry>
    </collision>
  </link>

  <!-- 完全用你SW导出的原始tool0关节，不做任何修改 -->
  <joint name="tool0" type="fixed">
    <origin xyz="0 0 -0.1085" rpy="0 0 0" />
    <parent link="link_base" />
    <child link="cup_link" />
    <axis xyz="0 0 0" />
  </joint>

</robot>

